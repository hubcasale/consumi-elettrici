{
  "name": "consumi-elettrici",
  "version": "0.2.0",
  "description": "Scheda Lovelace dei consumi elettrici (potenza, classifica dei consumatori, energia e costo per periodo), servita dall'integrazione consumi_elettrici.",
  "license": "MIT",
  "author": "Corrado Gamberoni",
  "repository": {
    "type": "git",
    "url": "https://github.com/hubcasale/consumi-elettrici"
  },
  "scripts": {
    "build": "esbuild src/consumi-elettrici-card.ts --bundle --format=esm --minify --outfile=custom_components/consumi_elettrici/frontend/consumi-elettrici-card.js",
    "build:dev": "esbuild src/consumi-elettrici-card.ts --bundle --format=iife --outfile=dev/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "lit": "^3.2.0"
  }
}
